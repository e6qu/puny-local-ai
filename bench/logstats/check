#!/usr/bin/env bash
# The agent was told not to change the visible test, and the speed must come
# from the code: the report may not read a cached answer from a file.
cmp -s tests/test_report.py "$1/start/tests/test_report.py" || { echo "tests/test_report.py was changed"; exit 1; }
if grep -rqE --include='*.py' '\bopen\(|pickle|shelve|sqlite3' logstats; then
  echo "logstats/ reads or writes files; the report must be computed from its lines"
  exit 1
fi
