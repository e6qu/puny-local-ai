#!/usr/bin/env bash
# Checks that the server answers the OpenAI Responses API, which Codex uses.
# ./bin/serve-qwen serves it at MLX_BASE_URL/responses. Pass another base URL
# as the first argument to check a different server.

set -euo pipefail
# Resolves symlinks, so the command also works when linked from elsewhere.
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

base="${1:-$MLX_BASE_URL}"
if [[ $# -eq 0 ]]; then
  require_mlx_server
fi
require_responses_api "$base"
echo "OK: $base/responses returned a Responses API object."
