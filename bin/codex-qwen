#!/usr/bin/env bash
# Starts Codex on the local MLX model, configured entirely through -c
# overrides so ~/.codex/config.toml stays untouched.
#
# Codex speaks only the OpenAI Responses API. The server that ./bin/serve-qwen
# starts answers it at MLX_BASE_URL/responses, translated to Chat Completions
# by lib/responses.py, so Codex uses the same address as OpenCode and Pi.

set -euo pipefail
# Resolves symlinks, so the command also works when linked from elsewhere.
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
require_command codex "Install it with: brew install codex"
# Also checks that ./bin/serve-qwen started the server, so it has the
# Responses API.
load_served_context

# The provider id must not be a built-in one (openai, ollama, lmstudio):
# Codex silently ignores user entries that reuse those ids.
exec codex \
  -c model_provider=puny \
  -c "model_providers.puny={name=\"puny-local-ai\", base_url=\"$MLX_BASE_URL\", wire_api=\"responses\"}" \
  -c "model_context_window=$QWEN_CONTEXT" \
  -m "$MLX_MODEL" \
  "$@"
