#!/usr/bin/env bash
# Has a team of fresh agent runs build what FOLDER/task.md asks for, until the
# folder's goal check passes: the method of GVS5H as written up in Memdoor's
# team-solve workflow, run as the workflow in workflows/team-solve/ (see
# ./bin/workflow check team-solve).
#
#   ./bin/team-solve [FOLDER]   default: the current folder
#
# FOLDER holds task.md and its goal: samples tests/N.in with tests/N.out
# (the team writes run.sh, the command that runs its program on a sample),
# check.sh (any command that exits 0 when the task is done), or both. The
# result can be any files in any language. It needs the server from
# ./bin/serve-qwen; WORKFLOW_AGENT and WORKFLOW_TIMEOUT apply.

set -euo pipefail
# Resolves symlinks, so the command also works when linked from elsewhere.
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

[[ $# -le 1 ]] || die "usage: $PUNY_ROOT/bin/team-solve [FOLDER]"
[[ -d "${1:-.}" ]] || die "${1:-.} is not a folder"
folder="$(cd "${1:-.}" && pwd)"
[[ -f "$folder/task.md" ]] || die "$folder/task.md is missing: write the task there"
shopt -s nullglob
inputs=("$folder"/tests/*.in)
shopt -u nullglob
[[ ${#inputs[@]} -gt 0 || -f "$folder/check.sh" ]] \
  || die "$folder has no goal to check: add samples tests/1.in with tests/1.out, or check.sh"
for input in ${inputs[@]+"${inputs[@]}"}; do
  [[ -f "${input%.in}.out" ]] || die "${input%.in}.out is missing: every sample input needs its expected output"
done
exec "$PUNY_ROOT/bin/workflow" team-solve "$folder"
