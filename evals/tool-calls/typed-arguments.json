{
  "description": "An ISO date-time, an integer and an array of emails, all derived from prose.",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "create_event",
        "description": "Create a calendar event.",
        "parameters": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "start": {
              "type": "string",
              "description": "ISO 8601 local date and time, such as 2026-01-31T09:00"
            },
            "duration_minutes": {
              "type": "integer"
            },
            "attendees": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "title",
            "start",
            "duration_minutes",
            "attendees"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": "Book a meeting called Design review on 3 November 2026 at half past two in the afternoon, for an hour and a half, with ana@studio.io and bo@studio.io."
    }
  ],
  "steps": [
    {
      "calls": [
        {
          "tool": "create_event",
          "args": {
            "title": {
              "iequals": "Design review"
            },
            "start": {
              "regex": "^2026-11-03T14:30"
            },
            "duration_minutes": 90,
            "attendees": {
              "same_items": [
                "ana@studio.io",
                "bo@studio.io"
              ]
            }
          },
          "result": {
            "id": "evt_5521",
            "status": "created"
          },
          "example": {
            "title": "Design review",
            "start": "2026-11-03T14:30:00",
            "duration_minutes": 90,
            "attendees": [
              "bo@studio.io",
              "ana@studio.io"
            ]
          }
        }
      ]
    },
    {
      "answer": {
        "contains": [
          [
            "created",
            "booked",
            "scheduled"
          ]
        ],
        "example": "The meeting is booked."
      }
    }
  ]
}
